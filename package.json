{
  "name": "chaintrace-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "ChainTrace — Blockchain Intelligence Platform for Cryptocurrency Fraud Investigation",
  "workspaces": [
    "apps/*",
    "packages/*"
