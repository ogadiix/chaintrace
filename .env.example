# ==============================================================================
# ChainTrace Environment Configuration Template
# ==============================================================================
# DO NOT COMMIT SECRETS TO SOURCE CONTROL.
# Copy this file to .env or .env.local for local development.

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Security & JWT Authentication
JWT_SECRET=change-this-to-a-secure-random-32-byte-hex-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Primary Transactional Database (PostgreSQL)
# For local dev without Postgres, fallback to SQLite: sqlite+aiosqlite:///./data/chaintrace.db
DATABASE_URL=postgresql+asyncpg://chaintrace_user:chaintrace_pass@localhost:5432/chaintrace_db
DATABASE_FALLBACK_SQLITE=true

# Graph Database (Neo4j)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=chaintrace_secure_pass
NEO4J_DATABASE=neo4j
NEO4J_MOCK_FALLBACK=true

# Cache & Asynchronous Job Queue (Redis)
REDIS_URL=redis://localhost:6379/0
REDIS_MOCK_FALLBACK=true

# Blockchain Provider RPC & API Credentials (Backend Only - Never Expose to UI)
TRON_API_URL=https://api.trongrid.io
TRON_API_KEY=
ETH_RPC_URL=https://eth.llamarpc.com
ETHERSCAN_API_KEY=
BTC_API_URL=https://blockstream.info/api

# Defensive Investigation Limits
DEFAULT_MAX_HOPS=4
ABSOLUTE_MAX_HOPS=7
MAX_NODES_PER_JOB=1000
MAX_EDGES_PER_JOB=2500
TRACE_TIMEOUT_SECONDS=60
