# ==============================================================================
# ChainTrace Environment Configuration Template
# ==============================================================================
# DO NOT COMMIT SECRETS TO SOURCE CONTROL.
# Copy this file to .env for local development.

# ------------------------------------------------------------------------------
# 1. Application Environment & Core Server
# ------------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

API_HOST=0.0.0.0
API_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Security & JWT Authentication
# ------------------------------------------------------------------------------
JWT_SECRET=change-this-to-a-secure-random-32-byte-hex-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Rate Limiting (per user per minute)
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_TRACE_PER_MINUTE=20
RATE_LIMIT_REPORT_PER_MINUTE=10
RATE_LIMIT_GENERAL_PER_MINUTE=60

# ------------------------------------------------------------------------------
# 3. Primary Databases & Queues
# ------------------------------------------------------------------------------
# PostgreSQL (Production) or SQLite (Local fallback)
DATABASE_URL=sqlite+aiosqlite:///./data/chaintrace.db
DATABASE_FALLBACK_SQLITE=true

# Graph Database (Neo4j)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=chaintrace_secure_pass
NEO4J_DATABASE=neo4j
NEO4J_MOCK_FALLBACK=true

# Cache & Asynchronous Job Queue (Redis)
REDIS_URL=redis://localhost:6379/0
REDIS_MOCK_FALLBACK=true

# ------------------------------------------------------------------------------
# 4. TRON Blockchain APIs (TRX & TRC-20 USDT)
# ------------------------------------------------------------------------------
# TronGrid API (Primary TRON JSON-RPC & HTTP Gateway)
# Free API key at: https://www.trongrid.io/
TRON_API_URL=https://api.trongrid.io
TRON_API_KEY=

# TronScan Explorer API (Account & Transfer Histories)
# Free API key at: https://tronscan.org/
TRONSCAN_API_URL=https://apilist.tronscanapi.com/api
TRONSCAN_API_KEY=

# ------------------------------------------------------------------------------
# 5. Ethereum & EVM L1 Blockchain APIs (ETH & ERC-20)
# ------------------------------------------------------------------------------
# Ethereum JSON-RPC Provider (Default: Public LlamaRPC, Infura, or Alchemy)
ETH_RPC_URL=https://eth.llamarpc.com
ETHEREUM_RPC_URL=https://eth.llamarpc.com

# Etherscan Developer API (Account token transfers, contract ABI, logs)
# Free API key at: https://etherscan.io/myapikey
ETHERSCAN_API_KEY=
ETHERSCAN_API_URL=https://api.etherscan.io/api

# Alchemy / Infura Dedicated RPC Keys (Optional for higher throughput)
ALCHEMY_API_KEY=
INFURA_PROJECT_ID=

# ------------------------------------------------------------------------------
# 6. BNB Smart Chain (BSC) APIs (BNB & BEP-20)
# ------------------------------------------------------------------------------
# BSC JSON-RPC Endpoint (Default: Public LlamaRPC or QuickNode)
BSC_RPC_URL=https://binance.llamarpc.com

# BscScan Developer API
# Free API key at: https://bscscan.com/myapikey
BSCSCAN_API_KEY=
BSCSCAN_API_URL=https://api.bscscan.com/api

# ------------------------------------------------------------------------------
# 7. Polygon Blockchain APIs (POL / MATIC & Polygon ERC-20)
# ------------------------------------------------------------------------------
# Polygon JSON-RPC Endpoint (Default: Public LlamaRPC)
POLYGON_RPC_URL=https://polygon.llamarpc.com

# PolygonScan Developer API
# Free API key at: https://polygonscan.com/myapikey
POLYGONSCAN_API_KEY=
POLYGONSCAN_API_URL=https://api.polygonscan.com/api

# ------------------------------------------------------------------------------
# 8. Bitcoin (BTC) UTXO APIs
# ------------------------------------------------------------------------------
# Blockstream Esplora REST API (UTXO indexing & address transactions)
BTC_API_URL=https://blockstream.info/api

# Mempool.space Public API (Mempool & transaction confirmation tracking)
MEMPOOL_SPACE_API_URL=https://mempool.space/api

# Blockchair Universal Blockchain API (Optional multi-engine indexer)
BLOCKCHAIR_API_KEY=
BLOCKCHAIR_API_URL=https://api.blockchair.com

# ------------------------------------------------------------------------------
# 9. Layer 2s & Alt-Chains (Arbitrum, Optimism, Solana)
# ------------------------------------------------------------------------------
# Arbitrum One JSON-RPC & Arbiscan
ARBITRUM_RPC_URL=https://arb1.llamarpc.com
ARBISCAN_API_KEY=

# OP Mainnet (Optimism) JSON-RPC & Etherscan V2
OPTIMISM_RPC_URL=https://optimism.llamarpc.com
OPTIMISMSCAN_API_KEY=

# Solana JSON-RPC & Solscan
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLSCAN_API_KEY=

# ------------------------------------------------------------------------------
# 10. Crypto Market Price Feeds & Currency Conversion
# ------------------------------------------------------------------------------
# CoinGecko API (Fiat valuations: USD, INR, EUR conversions)
COINGECKO_API_KEY=
COINGECKO_API_URL=https://api.coingecko.com/api/v3

# CryptoCompare API (Historical price snapshots for exact transaction timestamps)
CRYPTOCOMPARE_API_KEY=

# ------------------------------------------------------------------------------
# 11. Threat Intelligence, Sanctions & VASP Directories
# ------------------------------------------------------------------------------
# OFAC SDN Specially Designated Nationals Sanctions Feed
OFAC_SANCTIONS_DATA_URL=https://raw.githubusercontent.com/ChainTrace/sanctions/main/ofac.json

# Commercial Intelligence Integrations (Optional enterprise enrichment)
CHAINALYSIS_API_KEY=
ELLIPTIC_API_KEY=

# ------------------------------------------------------------------------------
# 12. National Agency Gateway Integrations (Simulation / Sandbox Mode)
# ------------------------------------------------------------------------------
# NCRP (National Cyber Crime Reporting Portal)
NCRP_API_URL=https://api.ncrp.gov.in/v1
NCRP_API_KEY=

# I4C SAHYOG Intermediary Coordination System
I4C_SAHYOG_API_URL=https://sahyog.i4c.gov.in/api/v1
I4C_SAHYOG_API_KEY=
I4C_SAHYOG_OFFICER_ID=CT-LE-9081

# ------------------------------------------------------------------------------
# 13. Defensive Investigation Limits & Provider Settings
# ------------------------------------------------------------------------------
PROVIDER_TIMEOUT_SECONDS=10.0
PROVIDER_MAX_RETRIES=3
PROVIDER_RATE_LIMIT_PER_SEC=5.0
BLOCKCHAIN_CACHE_TTL_SECONDS=300

DEFAULT_MAX_HOPS=4
ABSOLUTE_MAX_HOPS=7
MAX_NODES_PER_JOB=1000
MAX_EDGES_PER_JOB=2500
TRACE_TIMEOUT_SECONDS=60
REPORTS_DIR=./data/reports
